{
  "name": "study-tracker-desktop",
  "version": "1.0.1",
  "main": "main.js",
  "description": "Desktop wrapper for Study Tracker",
  "author": "User",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.studytracker.app",
    "productName": "Study Tracker",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*",
          "!**/.env",
          "!**/.env.*",
          "!desktop-app/**/*",
          "!setup/**/*",
          "!backups/**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!**/query_engine-*.node.tmp*"
        ]
      },
      {
        "from": "../.next/static",
        "to": "server/.next/static"
      },
      {
        "from": "../public",
        "to": "server/public",
        "filter": [
          "**/*",
          "!uploads/**/*"
        ]
      },
      {
        "from": "../node_modules/.prisma/client-sqlite-desktop",
        "to": "server/node_modules/.prisma/client-custom-v8",
        "filter": [
          "**/*",
          "!query_engine-*.node.tmp*"
        ]
      },
      {
        "from": "../prisma",
        "to": "prisma",
        "filter": [
          "**/*",
          "!*.db",
          "!*.db.bak*",
          "!dev.db*",
          "!migrations/**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "desktop.css",
      "icon.ico",
      "error.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "asar": true,
      "asarUnpack": [
        "**/query_engine-windows.dll.node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Study Tracker",
      "artifactName": "StudyTrackerSetup.exe",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "leviGatimu",
        "repo": "Study-Flow"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
