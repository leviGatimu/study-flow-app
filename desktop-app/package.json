{
  "name": "study-tracker-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Desktop wrapper for Study Tracker",
  "author": "User",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.studytracker.app",
    "productName": "Study Tracker",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.next/static",
        "to": "server/.next/static"
      },
      {
        "from": "../public",
        "to": "server/public"
      },
      {
        "from": "../node_modules/.prisma/client-custom-v8",
        "to": "server/node_modules/.prisma/client-custom-v8"
      },
      {
        "from": "../prisma",
        "to": "prisma"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "desktop.css",
      "icon.ico",
      "error.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "asar": true,
      "asarUnpack": [
        "**/query_engine-windows.dll.node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Study Tracker",
      "artifactName": "StudyTrackerSetup.exe"
    }
  }
}
