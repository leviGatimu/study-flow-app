generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-custom-v8"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(cuid())
  username        String             @unique
  passwordHash    String
  isAdmin         Boolean            @default(false)
  currentTerm     String             @default("Term 1")
  createdAt       DateTime           @default(now())
  templates       ScheduleTemplate[]
  tasks           Task[]
  resources       Resource[]
  examEvents      ExamEvent[]
  weeklySummaries WeeklySummary[]
  dailySummaries  DailySummary[]
  masteryItems    MasteryItem[]
  markedDays      MarkedDay[]
  progress        UserProgress?
  chatSessions    ChatSession[]
  projects        Project[]
  stickyNotes     StickyNote[]
  tutorModules    TutorModule[]
  studioNotes     StudioNote[]
  homeworks       Homework[]
  reportCards     ReportCard[]
  aiNotes         AiNote[]
  subjectGoals    SubjectGoal[]
  subjects        Subject[]
  songs           Song[]
  playlists       Playlist[]
  updatedAt       DateTime           @default(now()) @updatedAt
  deletedAt       DateTime?
  /// When the SERVER last had this version of the row.
  ///
  /// Two meanings, one column, and the difference is the whole engine:
  ///   on the server it is the write time, and the pull cursor orders by it;
  ///   on a device it is the server's stamp for the version last exchanged,
  ///   and NULL means "this row has local changes the server has not seen".
  /// A device therefore never compares its own clock with the server's - it
  /// asks "is syncedAt null", which no amount of clock skew can get wrong.
  syncedAt        DateTime?
  classes         Class[]
  xpEvents        XpEvent[]
  schoolLessons   SchoolLesson[]

  @@index([syncedAt])
}

/// Every XP grant that has ever happened, append-only.
///
/// UserProgress.xp and .level used to be the only record: addXp() read them,
/// added, and wrote them back. That had two consequences.
///
/// It made grants non-idempotent - toggleTaskDone paid +100 every time it was
/// called, so unticking and reticking a task paid twice.
///
/// And it made the values impossible to sync. Two devices each earning offline
/// produce two totals, and last-writer-wins does not add them - it discards
/// one, unrecoverably, because nothing recorded where the XP came from.
/// Append-only rows with a stable idempotency key need no conflict resolution
/// at all: merging is a union, and the total is a SUM over the union.
///
/// UserProgress.xp/.level are now a CACHE recomputed from this table, so every
/// page that reads them is unchanged.
model XpEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Always positive. Reversals are a compensating negative row, never a delete.
  amount Int
  /// TASK | HOMEWORK | STREAK | FOCUS | QUIZ | AI | LEGACY
  source String

  /// What earned it, e.g. "task:clx123" or "streak:clx456:2026-09-07".
  /// Unique per user: this is what makes a grant happen at most once, however
  /// many times the code path runs or the row is re-synced.
  sourceKey String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
  @@index([syncedAt])
}

model Song {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  artist     String?
  audioUrl   String // local file path under /uploads
  coverUrl   String? // optional album art under /uploads
  duration   Float? // seconds, measured client-side on upload
  lyrics     String? // LRC (synced) or plain text; from ID3 tags or LRCLIB
  createdAt  DateTime   @default(now())
  sourceType String     @default("LOCAL") // "LOCAL" (uploaded file) or "AUDIUS" (online)
  externalId String? // provider track id for online songs
  playlists  Playlist[]
  updatedAt  DateTime   @default(now()) @updatedAt
  deletedAt  DateTime?
}

model Playlist {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  songs     Song[]
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

model ReportCard {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  term           String
  overallAverage Float?
  aiSummary      String?
  fileUrl        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  grades         SubjectGrade[]
  deletedAt      DateTime?
  syncedAt       DateTime?
  termId         String?
  termRef        Term?          @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([termId])
  @@index([syncedAt])
}

model SubjectGrade {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject      String
  grade        String
  status       String // e.g., "Excellent", "Needs Work"
  aiFeedback   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  deletedAt    DateTime?
  syncedAt     DateTime?
  /// Denormalised from reportCard.termRef.classId so a grade can be filtered by
  /// academic year without joining through ReportCard and Term on every read.
  classId      String?
  class        Class?     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([syncedAt])
}

model Homework {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  title       String
  description String?
  dueDate     DateTime
  plannedDate DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  proofUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  termId      String?
  termRef     Term?     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([termId])
  @@index([syncedAt])
}

model StudioNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  content   String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?
  classId   String?
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
  @@index([classId])
  @@index([syncedAt])
}

model TutorModule {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String
  title          String
  sourcePdfUrl   String?
  notes          String // Markdown (Legacy/Optional)
  videos         String // JSON array (Legacy/Optional)
  flashcards     String // JSON array (Legacy/Optional)
  exercises      String // JSON array (Legacy/Optional)
  questions      String        @default("[]") // JSON array: { id, question, expectedAnswer }
  score          Int?
  understanding  String? // "Beginner", "Intermediate", "Master"
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?     @updatedAt
  attempts       QuizAttempt[]
  deletedAt      DateTime?
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model QuizAttempt {
  id        String      @id @default(cuid())
  moduleId  String
  module    TutorModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  score     Int
  feedback  String // JSON array: { questionId, studentAnswer, isCorrect, aiFeedback }
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  deletedAt DateTime?
  /// Inherited from the module the attempt belongs to.
  classId   String?
  class     Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model Project {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String       @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "ARCHIVED"
  progress    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  docs        ProjectDoc[]
  deletedAt   DateTime?
  classId     String?
  class       Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model ProjectDoc {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String // Markdown or plain text content
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  deletedAt DateTime?
  /// The academic year the conversation happened in. ChatMessage deliberately
  /// has no column of its own: it is scoped through its session.
  classId   String?
  class     Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" or "model"
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  deletedAt DateTime?
}

model ScheduleTemplate {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 for Sunday, 1 for Monday, etc.
  subject     String
  startTime   String // format "HH:MM" 24hr
  endTime     String // format "HH:MM" 24hr
  deadlineDay String
  type        String // "HOMEWORK" or "REVISION"
  tasks       Task[]
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([syncedAt])
}

/// One period in the user's SCHOOL day - the lessons they attend, not the study
/// blocks they set themselves.
///
/// ScheduleTemplate is the evening timetable the student owns: homework and
/// revision they schedule. This is the other half, the day the school owns, and
/// the two are deliberately separate models - a lesson is not something you
/// tick off, generates no Task, and earns no XP.
///
/// It exists because this timetable used to be a hardcoded array inside
/// components/SchoolTimetable.tsx. Every user's dashboard, notifications and
/// week view therefore showed ONE student's real school day.
///
/// Class-scoped like ScheduleTemplate: a new academic year starts with an empty
/// school timetable, because the lessons genuinely changed.
model SchoolLesson {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 for Sunday, 1 for Monday - the same convention as ScheduleTemplate
  startTime String // format "HH:MM" 24hr
  endTime   String // format "HH:MM" 24hr
  subject   String

  /// Breaks and lunch are lessons in the timetable's sense - they occupy a slot
  /// and the day is wrong without them - but they are not something you attend,
  /// so the UI greys them out rather than guessing from the subject name.
  isBreak Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@index([classId])
  @@index([syncedAt])
}

model Task {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String? // Optional for one-off tasks
  template        ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String // Added for individual editing
  endTime         String // Added for individual editing
  subject         String
  isDone          Boolean           @default(false)
  isMissed        Boolean           @default(false)
  isDeleted       Boolean           @default(false) // Added to prevent regeneration
  type            String // "HOMEWORK" or "REVISION"
  workDescription String? // Added for proof of work
  proofPdfUrl     String? // Added for PDF proof of work
  updatedAt       DateTime          @default(now()) @updatedAt
  deletedAt       DateTime?
  syncedAt        DateTime?
  termId          String?
  termRef         Term?             @relation(fields: [termId], references: [id], onDelete: Cascade)

  /// Set when this block was generated by planning revision for an exam.
  /// SetNull, not Cascade: deleting an exam must not delete revision you have
  /// already done for it.
  examId String?
  exam   ExamEvent? @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([termId])
  @@index([syncedAt])
}

model MarkedDay {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?
  termId    String?
  termRef   Term?     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([termId])
  @@index([syncedAt])
}

model UserProgress {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    @default("Student") // For personalized greeting
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastActiveDate    DateTime?
  schoolEndDate     DateTime? // User's marked last day of school; streak pauses after it until resumed
  geminiApiKey      String? // Added for AI Study Buddy
  openaiApiKey      String? // Added for OpenAI API key
  primaryAiProvider String    @default("gemini") // "gemini", "openai", or "ollama"
  ollamaEnabled     Boolean   @default(true) // allow offline fallback to a local Ollama model
  ollamaBaseUrl     String    @default("http://localhost:11434") // local Ollama server
  ollamaModel       String? // chosen text/general model (e.g. "llama3.1")
  ollamaVisionModel String? // optional vision-capable model for image analysis (e.g. "llama3.2-vision")
  focusSessions     Int       @default(0)
  totalFocusMinutes Int       @default(0)
  xp                Int       @default(0)
  level             Int       @default(1)
  dailySummaryTime  String    @default("21:00") // "HH:MM" local time-of-day to auto-generate the daily summary
  timezone          String    @default("Africa/Kigali") // IANA timezone used for "today" math, the clock, and greetings

  /// When this account finished (or skipped) the welcome tour.
  ///
  /// On the ACCOUNT, not in localStorage, and that is the whole point. The flag
  /// used to live in the browser, which meant the desktop app forgot it every
  /// time it started on a different port - desktop-app/main.js takes the first
  /// free port from 3000, and localhost:3000 and localhost:3001 are different
  /// origins with different storage. So the tour reappeared on almost every
  /// launch, for an account that had seen it a dozen times.
  ///
  /// Nullable, and null means "never seen it". Existing accounts are backfilled
  /// to their creation date by the migration: they have been using the app for
  /// months and being handed a tour would be the same bug pointing the other
  /// way.
  onboardedAt DateTime?

  /// When this account finished the setup wizard, or dismissed it for good.
  ///
  /// Separate from `onboardedAt` because they answer different questions.
  /// `onboardedAt` is "has this person been shown around"; this is "has this
  /// person been ASKED for the things the app cannot work without" - their year,
  /// their term, their subjects, an AI key. An account can have seen the tour
  /// and still have nothing configured, and before this column that was the
  /// normal state of every new account.
  ///
  /// Deliberately the ONLY setup state stored. Which individual steps are done
  /// is derived from the real data (does a subject exist? is a key set?) rather
  /// than recorded, so a checklist can never claim a step is finished after the
  /// thing it created was deleted. This column only records "stop asking me",
  /// which nothing else can tell us.
  ///
  /// Backfilled for existing accounts: they configured themselves by hand long
  /// before a wizard existed, and being sent through one now would be noise.
  setupCompletedAt DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?

  @@index([syncedAt])
}

model Resource {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  title     String
  type      String // "LINK" or "FILE"
  url       String // URL or local file path
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?
  classId   String?
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([syncedAt])
}

model ExamEvent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  date     DateTime
  priority String   @default("NORMAL") // "LOW" | "NORMAL" | "HIGH"

  /// The subject this assesses. Before this existed, `title` was used as the
  /// subject key - so an exam called "Physics Paper 1" silently returned zero
  /// preparation stats because no subject is named that.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  /// "HH:MM", optional: not every exam has a known time.
  startTime String?
  endTime   String?
  room      String?

  /// QUIZ | TEST | MIDTERM | FINAL | EXAM
  kind   String @default("EXAM")
  /// Share of the term grade, as a percentage, when known.
  weight Float?

  /// Result, filled in after the exam is sat. Feeds Marks and Insights.
  score    Float?
  maxScore Float?
  notes    String?

  /// Revision blocks generated by planning backwards from `date`.
  revisionTasks Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?
  syncedAt      DateTime?
  termId        String?
  termRef       Term?     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([termId])
  @@index([syncedAt])
}

model WeeklySummary {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime
  grade            String
  totalMinutes     Int
  subjectBreakdown String // Stored as JSON string
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime?
  termId           String?
  termRef          Term?     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([userId, startDate, endDate])
  @@index([termId])
}

model DailySummary {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  grade            String
  totalMinutes     Int
  completedMinutes Int       @default(0)
  subjectBreakdown String // Stored as JSON string
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime?
  termId           String?
  termRef          Term?     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([termId])
}

model MasteryItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String // Normalized subject name
  title       String
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([syncedAt])
}

model StickyNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  color     String    @default("#fef08a") // Default tailwind yellow-200
  isDone    Boolean   @default(false)
  x         Float     @default(0)
  y         Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  classId   String?
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model AiNote {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String // Markdown notes
  sourceName  String? // Filename of upload
  stylePreset String? // Preset name (e.g. Detailed, Summary, Q&A)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model SubjectGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  targetGrade Float // Target percentage grade, e.g. 85.0
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
  @@index([classId])
  @@index([syncedAt])
}

model Subject {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?
  classId   String?
  class     Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  exams     ExamEvent[]

  @@unique([userId, name])
  @@index([classId])
  @@index([syncedAt])
}

/// An academic year (what Levi calls a "class"): Year 1, S6, Level 300.
/// Exactly one Class per user is ACTIVE at a time. Completing one archives it
/// read-only and opens the next, empty.
model Class {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free text so any school's naming works ("Year 1", "S6", "Freshman").
  label  String
  /// ACTIVE | COMPLETED
  status String @default("ACTIVE")

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// JSON end-of-year summary, written when the class is completed (Phase 4).
  summary     String?

  /// The streak resets per class, while XP and level stay lifetime on
  /// UserProgress. Lets the app say "Year 2: 12 days, all-time best 41".
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  /// Manual pause, usable any day mid-term. Stops task generation and freezes
  /// the streak without ending the term. Replaces UserProgress.schoolEndDate.
  pausedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?

  terms             Term[]
  scheduleTemplates ScheduleTemplate[]
  subjects          Subject[]
  subjectGoals      SubjectGoal[]
  resources         Resource[]
  masteryItems      MasteryItem[]
  tutorModules      TutorModule[]
  studioNotes       StudioNote[]
  aiNotes           AiNote[]
  projects          Project[]
  subjectGrades     SubjectGrade[]
  quizAttempts      QuizAttempt[]
  chatSessions      ChatSession[]
  stickyNotes       StickyNote[]
  schoolLessons     SchoolLesson[]

  @@index([userId, status])
  @@index([syncedAt])
}

/// A term within a class. Dates only ever prompt ("Term 2 ends today"); they
/// never transition anything on their own.
model Term {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// Denormalised so term-scoped queries can filter by user without a join.
  userId  String

  name  String
  index Int

  startDate DateTime?
  endDate   DateTime?
  /// UPCOMING | ACTIVE | COMPLETED
  status    String    @default("UPCOMING")
  /// JSON end-of-term summary (Phase 4).
  summary   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?

  tasks           Task[]
  examEvents      ExamEvent[]
  homeworks       Homework[]
  dailySummaries  DailySummary[]
  weeklySummaries WeeklySummary[]
  markedDays      MarkedDay[]
  reportCards     ReportCard[]

  @@unique([classId, index])
  @@index([userId, status])
  @@index([syncedAt])
}

/// One row per device, holding where that device got to.
///
/// LOCAL ONLY - it never syncs, and on the server it stays empty: the server
/// has no cursor because it is the thing every device is catching up to.
///
/// `cursor` is a value the SERVER produced (the highest syncedAt a pull
/// delivered), never a local clock reading, which is the entire reason the
/// cursor survives a device whose clock is wrong.
model SyncState {
  id       String @id @default(cuid())
  userId   String
  /// Stable per install. Minted on first sync and kept in this row.
  deviceId String

  /// Highest syncedAt this device has pulled through, and the id it stopped
  /// on - the pair is the cursor, because many rows can share a millisecond.
  cursor   DateTime?
  cursorId String?

  /// Where to sync to, and how this device proves who it is.
  ///
  /// The token is a long-lived session for the web app, obtained once by
  /// signing in at /api/sync/session. It is stored in plain text in the local
  /// database, which sits in the OS user's own profile directory alongside the
  /// password hashes it already holds - the same trust boundary, not a new one.
  /// Anyone who can read this file can already read every note and mark in it.
  serverUrl String?
  token     String?

  /// For the UI: when the last full exchange finished, and how it went.
  lastSyncAt DateTime?
  lastError  String?
  lastPushed Int       @default(0)
  lastPulled Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, deviceId])
}
