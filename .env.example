# Copy this file to .env for local development, and set the same three
# variables in your Vercel project (Settings → Environment Variables).
# The real .env is gitignored and never committed.

# Supabase Postgres — session-mode pooler (port 5432), used at runtime.
#
# NOT the transaction pooler on 6543: it measured ~790ms per query against
# ~180ms here, which is a 2-second page against an 8-second one. The cost of
# that choice is a 15-client ceiling for the whole project — see "Why the
# session pooler" in README.md before changing this.
#
# connection_limit matters on Vercel, where several instances share those 15
# slots. Leave it out and lib/prisma.ts applies 3; set it to override.
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=20"

# Supabase Postgres — session-mode pooler (port 5432).
# Used by Prisma for migrations / introspection (directUrl).
DIRECT_URL="postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign the auth JWT cookie. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<a-long-random-secret>"

# ---------------------------------------------------------------------------
# File uploads.
#
# Leave these UNSET for the desktop build: files belong on the user's own disk.
#
# SET THEM ON VERCEL. The deployed app writes uploads to public/uploads, and
# Vercel's filesystem is ephemeral and read-only at runtime - so every uploaded
# PDF, proof and song is currently lost on the next deploy.
#
# Setup: Supabase dashboard -> Storage -> New bucket -> name it "uploads".
# Leave it PRIVATE. The app serves these files through its own authenticated
# /uploads route, so a public bucket would only make your report cards and
# proofs of work readable by anyone holding the link.
#
# The service role key is in Settings -> API. It bypasses row-level security,
# so it must only ever be set server-side, never in a NEXT_PUBLIC_ variable.
# Set these on Vercel only - the desktop build must keep writing to disk.
SUPABASE_URL="https://<project_ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="uploads"

# Desktop only - set by desktop-app/main.js, never by hand. Points the server
# at the resource library (Documents\Study Tracker), which the Resources page
# mirrors as a file explorer. Leave unset for the web build and `next dev`.
# LIBRARY_DIR="C:\Users\you\Documents\Study Tracker"
