# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local database (contains password hashes & API keys — never commit)
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
prisma/dev.db

# user-uploaded files (personal documents)
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Auto-committer ignored files
*.tmp
*.temp
*.log
*.cache
*.dll
*.exe
*.env
.vscode/**
.idea/**
.vs/**
node_modules/**
.git/**
dist/**
build/**
*.swp
*.swo
Thumbs.db

# desktop app build output / deps (regenerated by electron-builder)
desktop-app/node_modules/
desktop-app/dist/
desktop-app/out.txt
desktop-app/err.txt

# personal local Claude Code permission overrides (not shared)
.claude/settings.local.json

# raw database backups (contain password hashes & personal data — never commit)
/backups/

.vercel
